#include <SDL2/SDL.h>
#include <SDL2/SDL_events.h>
#include <SDL2/SDL_render.h>
#include <SDL2/SDL_surface.h>
#include <SDL2/SDL_video.h>
#include <math.h>


#define WINDOW_H 640
#define WINDOW_W 640

typedef struct {
    float x;
    float y;
} Vector2;

typedef struct {
    float x;
    float y;
    float z;
} Vector3;

Vector2 Vec2(float x, float y) {
    return (Vector2) {
        .x = x,
        .y = y
    };
}

Vector3 Vec3(float x, float y, float z) {
    return (Vector3) {
        .x = x,
        .y = y,
        .z = z
    };
}


Vector3 rotate_vec3(Vector3 input, float angle_rad) {
    float c = cos(angle_rad);
    float s = sin(angle_rad);

    return (Vector3) {
        .x = input.x * c - input.z * s,
        .y = input.y,
        .z = input.z * c + input.x * s,
    };
}

void draw_marker(SDL_Renderer *renderer, Vector2 position) {
    SDL_SetRenderDrawColor(renderer, 0, 255, 0, 255);
    SDL_Rect marker = {
        .x = position.x,
        .y = position.y,
        .h = 10,
        .w = 10
    };


    marker.x -= marker.w / 2.0;
    marker.y -= marker.h / 2.0;

    SDL_RenderFillRect(renderer, &marker);
}

Vector2 coordinate(Vector2 input) {
    return (Vector2) {
        .x = ((input.x + 1) / 2) * WINDOW_W,
        .y = (1 - (input.y + 1) / 2) * WINDOW_H
    };
}

Vector2 project(Vector3 input) {
    return (Vector2) {
        .x = input.x / input.z,
        .y = input.y / input.z
    };
}

int main() {
    SDL_Init(SDL_INIT_VIDEO);

    SDL_Window *window = NULL;
    SDL_Renderer *renderer = NULL;

    SDL_CreateWindowAndRenderer(WINDOW_W, WINDOW_H, SDL_WINDOW_SHOWN, &window, &renderer);


    int window_open = 1;
    SDL_Event event;

    const int fps = 60;
    float dzplace = 6;
    const float dt = 1.0 / fps;
    float angle = 0;



    while (window_open) {
        if (SDL_PollEvent(&event)) {
            if (event.type == SDL_QUIT) {
                window_open = 0;
            }
        }

        dzplace += 0.3 * dt;
        angle += 2 * 3.14159 * dt;

        Vector3 vertices[8] = {
                Vec3(0.5, 0.5, dzplace - 0.5),
                Vec3(-0.5, 0.5, dzplace - 0.5),
                Vec3(0.5, -0.5, dzplace - 0.5),
                Vec3(-0.5, -0.5, dzplace - 0.5),
                Vec3(0.5, 0.5, dzplace + 0.5),
                Vec3(-0.5, 0.5, dzplace + 0.5),
                Vec3(0.5, -0.5, dzplace + 0.5),
                Vec3(-0.5, -0.5, dzplace + 0.5),
        };

        SDL_SetRenderDrawColor(renderer, 40, 40, 40, 255);
        SDL_RenderClear(renderer);

        for (int i = 0; i < sizeof(vertices) / sizeof(vertices[0]); i++) {
            draw_marker(renderer, (coordinate(project(rotate_vec3(vertices[i], angle)))));
        }

        SDL_RenderPresent(renderer);
        SDL_Delay(dt * 1000);
    }

    SDL_DestroyRenderer(renderer);
    SDL_DestroyWindow(window);
    SDL_Quit();

    return 0;
}
